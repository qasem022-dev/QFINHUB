{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "qfinhub/calculator",
  "title": "Financial Calculator",
  "category": "widgets",
  "icon": "calculator",
  "description": "Embed any QFINHUB financial calculator — mortgage, loans, investing, retirement, debt or savings.",
  "keywords": ["calculator", "mortgage", "loan", "finance", "interest"],
  "textdomain": "qfinhub-calculators",
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "spacing": { "margin": true, "padding": true }
  },
  "attributes": {
    "calculatorId": { "type": "string", "default": "mortgage-payment" },
    "title": { "type": "string", "default": "" }
  },
  "editorScript": "file:./index.js",
  "style": "qfinhub-calculators"
}
